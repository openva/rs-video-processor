# Worker counts for the drain-mode pipeline (bin/pipeline_parallel.sh), read by
# video-pipeline.service. Sized for a 4-vCPU, 8 GB instance such as c7a.xlarge.
# To override on one machine without a deploy, put the same variables in
# /home/ubuntu/video-processor.env, which the service reads after this file.
FETCH_WORKERS=2
SCREENSHOT_WORKERS=2
TRANSCRIPT_WORKERS=1
BILL_WORKERS=2
SPEAKER_WORKERS=2
ARCHIVE_WORKERS=1

# AWS Transcribe speaker diarization for floor videos that have no speaker
# metadata and no on-screen names. It is billed per audio hour and returns
# anonymous labels (spk_0, spk_1). 0 = off, 1 = on. Unset also means off.
SPEAKER_DIARIZATION=0
