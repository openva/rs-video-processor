[Unit]
Description=Richmond Sunlight Video Processing Pipeline
# Order after the code-update service, but only Wants= (not Requires=): a
# best-effort code update must never be a hard gate that blocks an already-
# deployed pipeline. If update-from-s3.service fails, systemd still runs us.
After=network-online.target update-from-s3.service
Wants=network-online.target update-from-s3.service
ConditionPathExists=/home/ubuntu/video-processor.txt

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/video-processor
# Worker counts, deployed with the code. One VAR=value per line.
EnvironmentFile=-/home/ubuntu/video-processor/deploy/video-processor.env
# Optional per-machine overrides of the same variables, plus JOBS_PER_WORKER and
# MAX_DRAIN_RUNTIME_SECONDS. Read second, so it wins. The leading "-" means a
# file may be absent.
EnvironmentFile=-/home/ubuntu/video-processor.env
# --drain: keep making passes until nothing is pending, the time limit is
# reached, or the pending count stops dropping.
ExecStart=/home/ubuntu/video-processor/deploy/run-pipeline.sh --drain
ExecStopPost=/home/ubuntu/video-processor/deploy/auto-shutdown.sh
# Past the 6-hour drain limit (MAX_DRAIN_RUNTIME_SECONDS), which is checked only
# between passes. A run still going after 8 hours is hung: systemd stops it and
# ExecStopPost still runs the shutdown check. Raise this if you raise that limit.
TimeoutStartSec=8h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
